# Source database: the old Payload site. This is read-only for the migration scripts.
LEGACY_DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.example.mongodb.net/test?retryWrites=true&w=majority

# Destination database: use the separate `v1` database in the same cluster.
# This is a database name, not the `v1` collection inside `jouluristeily`.
# DATABASE_URL takes precedence over MONGODB_URI.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.example.mongodb.net/v1?retryWrites=true&w=majority

# The existing Payload secret can be reused. Keep this value private and long.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Local development URL. Set this to your production URL in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
